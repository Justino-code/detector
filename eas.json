{
  "cli": {
    "version": ">= 16.31.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "android": {
        "buildType": "apk"
      },

      "env": {
        "EXPO_PUBLIC_PLANTNET_API_URL": "@EXPO_PUBLIC_PLANTNET_API_URL",
        "EXPO_PUBLIC_PLANTNET_DISEASES_API_URL": "@EXPO_PUBLIC_PLANTNET_DISEASES_API_URL",
        "EXPO_PUBLIC_PLANTNET_API_KEY": "@PLANTNET_API_KEY",
        "EXPO_PUBLIC_KINDUISE_API_URL": "@EXPO_PUBLIC_KINDUISE_API_URL",
        "EXPO_PUBLIC_KINDUISE_API_KEY": "@EXPO_PUBLIC_KINDUISE_API_KEY",
        "EXPO_PUBLIC_APP_NAME": "@EXPO_PUBLIC_APP_NAME",
        "EXPO_PUBLIC_APP_VERSION": "@EXPO_PUBLIC_APP_VERSION"
      },

      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
